---
/** Petites icônes dessinées au même trait (1.75), sans bibliothèque. */
interface Props { name: 'arrow-right' | 'arrow-down' | 'arrow-up' | 'download' | 'github' | 'copy' | 'mail' | 'arrow-left' }
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
  {name === 'arrow-right' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === 'arrow-down' && <path d="M12 4v15M6 13l6 6 6-6" />}
  {name === 'arrow-up' && <path d="M12 20V5M6 11l6-6 6 6" />}
  {name === 'download' && <path d="M12 3v12M7 10l5 5 5-5M4 20h16" />}
  {name === 'copy' && <path d="M8 8h12v12H8zM4 16V4h12" />}
  {name === 'mail' && <path d="M3 5h18v14H3zM3 6l9 7 9-7" />}
  {name === 'github' && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  )}
</svg>
