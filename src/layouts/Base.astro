---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import fontUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  headerTheme?: 'wall' | 'screen';
  motion?: boolean;
}
const { title, description = site.description, headerTheme = 'wall', motion = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b1222" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {motion && (
      <script is:inline>
        if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          document.documentElement.classList.add('motion');
          // Filet de sécurité : si le script d'animation ne démarre pas, on affiche tout.
          setTimeout(function () {
            if (!window.__motionReady) document.documentElement.classList.remove('motion');
          }, 2500);
        }
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header theme={headerTheme} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<script>
  // L'en-tête prend la couleur de la section qu'il survole.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sections = [...document.querySelectorAll<HTMLElement>('main [data-theme]')];
  if (header && sections.length) {
    const update = () => {
      const probe = header.offsetHeight / 2;
      let current: HTMLElement | undefined;
      for (const s of sections) {
        const r = s.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe) current = s;
      }
      // data-theme-now : thème imposé pendant une animation (le zoom dans l'écran).
      const theme = current?.dataset.themeNow ?? current?.dataset.theme ?? 'wall';
      header.dataset.theme = theme === 'wall-light' ? 'wall' : theme;
      const clear = current?.hasAttribute('data-header-clear') && !current?.dataset.themeNow;
      header.classList.toggle('is-solid', window.scrollY > 8 && !clear);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('header:refresh', update);
    window.addEventListener('resize', update);
  }
</script>
